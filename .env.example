# Copy this file to `.env` and fill in values from Firebase console:
# Project settings → Your apps → Web app → SDK setup and configuration.
#
# These values are PUBLIC web configuration (they identify your project, they are not secrets).
# Security comes from Firebase Auth, Firestore/Storage rules, and Cloud Functions.
# NEVER put AI provider keys or service-account credentials in any VITE_ variable.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Region where the Cloud Functions are deployed (default: us-central1).
VITE_FUNCTIONS_REGION=us-central1

# Set to "true" to force the local demo backend even when Firebase is configured.
# Demo mode stores data in the browser only and is NOT secure. Leave unset for production.
VITE_DEMO_MODE=false
